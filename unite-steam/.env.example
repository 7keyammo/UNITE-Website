# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://unitesteam.com

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys). Use test keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: send the hero "Register" button to an outside form instead of the on-page form
NEXT_PUBLIC_REGISTER_FORM_URL=

# Local development only: set to 1 to preview member content without logging in.
# Ignored in production builds.
DEV_UNLOCK_ALL=
